diff --git a/internal/http2/eidolon_ping.go b/internal/http2/eidolon_ping.go
new file mode 100644
index 0000000..aa0eb27
--- /dev/null
+++ b/internal/http2/eidolon_ping.go
@@ -0,0 +1,79 @@
+package http2
+
+import (
+	"encoding/binary"
+	"time"
+)
+
+// prefacePing is the state of the preface PING of a connection
+// (Transport.PrefacePing), under ClientConn.mu.
+type prefacePing struct {
+	id       uint64  // of the last PING sent
+	data     [8]byte // payload of the PING in flight
+	inFlight bool    // sent, not acknowledged
+	checking bool    // a check of the PING pending
+}
+
+// readNow returns the time since cc was created, the clock of
+// ClientConn.lastRead.
+func (cc *ClientConn) readNow() time.Duration {
+	return time.Since(cc.born)
+}
+
+// maybePrefacePing sends a PING, as Chromium's MaybeSendPrefacePing, if
+// Transport.PrefacePing is set, nothing was read on cc for longer than it,
+// and no PING is in flight or being checked. The payload counts the PINGs
+// from 1. It is called with cc.wmu held, right after a HEADERS or a DATA
+// frame with payload, which the PING follows on the wire.
+func (cc *ClientConn) maybePrefacePing() {
+	d := cc.t.PrefacePing
+	if d == 0 {
+		return
+	}
+	cc.mu.Lock()
+	p := &cc.prefacePing
+	if p.checking || cc.readNow() <= time.Duration(cc.lastRead.Load())+d {
+		cc.mu.Unlock()
+		return
+	}
+	p.id++
+	binary.BigEndian.PutUint64(p.data[:], p.id)
+	p.inFlight, p.checking = true, true
+	data, sent := p.data, cc.readNow()
+	cc.mu.Unlock()
+	cc.fr.WritePing(false, data)
+	time.AfterFunc(d, func() { cc.checkPrefacePing(sent) })
+}
+
+// checkPrefacePing checks the PING in flight as Chromium's
+// CheckPingStatus, one PrefacePing after it was sent or after the last
+// check, at last: once acknowledged, it is done; if nothing was read since
+// then, or for PrefacePing, the connection is lost; otherwise it checks
+// again one PrefacePing after the last read.
+func (cc *ClientConn) checkPrefacePing(last time.Duration) {
+	d := cc.t.PrefacePing
+	cc.mu.Lock()
+	p := &cc.prefacePing
+	if !p.inFlight || cc.closed {
+		p.checking = false
+		cc.mu.Unlock()
+		return
+	}
+	now, read := cc.readNow(), time.Duration(cc.lastRead.Load())
+	if now > read+d || read < last {
+		p.checking = false
+		cc.mu.Unlock()
+		cc.closeForLostPing()
+		return
+	}
+	cc.mu.Unlock()
+	time.AfterFunc(read+d-now, func() { cc.checkPrefacePing(now) })
+}
+
+// prefacePingAcked records the acknowledgment of a PING with data. cc.mu
+// must be held.
+func (cc *ClientConn) prefacePingAcked(data [8]byte) {
+	if p := &cc.prefacePing; p.inFlight && data == p.data {
+		p.inFlight = false
+	}
+}
diff --git a/internal/http2/eidolon_ping_test.go b/internal/http2/eidolon_ping_test.go
new file mode 100644
index 0000000..7442fb1
--- /dev/null
+++ b/internal/http2/eidolon_ping_test.go
@@ -0,0 +1,177 @@
+// Preface PING of Chromium (patch 0023).
+
+package http2
+
+import (
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"slices"
+	"testing"
+	"testing/synctest"
+	"time"
+)
+
+// pingConn returns a connection with PrefacePing of 10 s to a wireServer
+// with o, a function that sends a request with body (nil for a GET)
+// without waiting for it, and one that closes the connection and returns
+// the HEADERS, DATA with payload and PING frames the client sent, as
+// "H1", "D1" and "P1" with the stream or the PING counter. It runs in a
+// synctest bubble.
+func pingConn(t *testing.T, o wireOptions) (*ClientConn, func(body io.Reader) <-chan error, func() []string) {
+	client, server := net.Pipe()
+	seen := wireServer(server, o)
+	cc, err := (&Transport{PrefacePing: 10 * time.Second}).newClientConn(client, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	send := func(body io.Reader) <-chan error {
+		method := http.MethodGet
+		if body != nil {
+			method = http.MethodPost
+		}
+		req, _ := http.NewRequest(method, "https://example.com/", body)
+		done := make(chan error, 1)
+		go func() {
+			resp, err := cc.RoundTrip(req)
+			if err == nil {
+				resp.Body.Close()
+			}
+			done <- err
+		}()
+		synctest.Wait()
+		return done
+	}
+	frames := func() []string {
+		client.Close()
+		var got []string
+		for f := range seen {
+			switch {
+			case f.typ == FrameHeaders:
+				got = append(got, fmt.Sprint("H", f.stream))
+			case f.typ == FrameData && f.length > 0:
+				got = append(got, fmt.Sprint("D", f.stream))
+			case f.typ == FramePing && f.flags&FlagPingAck == 0:
+				got = append(got, fmt.Sprint("P", binary.BigEndian.Uint64(f.ping[:])))
+			}
+		}
+		return got
+	}
+	return cc, send, frames
+}
+
+// No PING on a connection read from in the last 10 s, new or not; after
+// 10 s without a read, a PING right after the next HEADERS, or after the
+// next DATA with payload, counting from 1; never after an empty DATA.
+func TestPrefacePing(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		_, send, frames := pingConn(t, wireOptions{})
+		<-send(nil) // new connection
+		<-send(nil)
+		time.Sleep(11 * time.Second)
+		<-send(nil)
+		<-send(nil) // a response was just read
+		time.Sleep(11 * time.Second)
+		<-send(nil)
+		// The HEADERS go right after a read, the DATA 11 s later.
+		pr, pw := io.Pipe()
+		done := send(pr)
+		time.Sleep(11 * time.Second)
+		pw.Write([]byte("body"))
+		pw.Close()
+		<-done
+		// An empty DATA, only ending the stream, sends none.
+		pr, pw = io.Pipe()
+		done = send(pr)
+		time.Sleep(11 * time.Second)
+		pw.Close()
+		<-done
+		want := []string{"H1", "H3", "H5", "P1", "H7", "H9", "P2", "H11", "D11", "P3", "H13"}
+		if got := frames(); !slices.Equal(got, want) {
+			t.Errorf("frames %v, want %v", got, want)
+		}
+	})
+}
+
+// Without a read for 10 s while the PING is unanswered, the connection is
+// lost; meanwhile, no other PING is sent.
+func TestPrefacePingLost(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		cc, send, frames := pingConn(t, wireOptions{silent: true})
+		time.Sleep(11 * time.Second)
+		first := send(nil) // t=11: PING
+		time.Sleep(4 * time.Second)
+		second := send(nil) // t=15: no PING, one is being checked
+		time.Sleep(5900 * time.Millisecond)
+		synctest.Wait()
+		if cc.State().Closed {
+			t.Fatal("closed at 20.9 s")
+		}
+		time.Sleep(200 * time.Millisecond)
+		synctest.Wait()
+		if !cc.State().Closed {
+			t.Fatal("open at 21.1 s")
+		}
+		for _, done := range []<-chan error{first, second} {
+			if err := <-done; err == nil {
+				t.Error("request answered on a lost connection")
+			}
+		}
+		if got, want := frames(), []string{"H1", "P1", "H3"}; !slices.Equal(got, want) {
+			t.Errorf("frames %v, want %v", got, want)
+		}
+	})
+}
+
+// An unanswered PING is checked again while the connection reads: it is
+// lost 10 s after the last read, not 10 s after the PING.
+func TestPrefacePingRead(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		cc, send, frames := pingConn(t, wireOptions{noPings: true})
+		time.Sleep(11 * time.Second)
+		<-send(nil) // t=11: PING, response read
+		time.Sleep(4 * time.Second)
+		<-send(nil) // t=15: response read
+		time.Sleep(9900 * time.Millisecond)
+		synctest.Wait()
+		if cc.State().Closed {
+			t.Fatal("closed at 24.9 s")
+		}
+		time.Sleep(200 * time.Millisecond)
+		synctest.Wait()
+		if !cc.State().Closed {
+			t.Fatal("open at 25.1 s")
+		}
+		if got, want := frames(), []string{"H1", "P1", "H3"}; !slices.Equal(got, want) {
+			t.Errorf("frames %v, want %v", got, want)
+		}
+	})
+}
+
+// Without PrefacePing, no PING however long the connection was not read.
+func TestNoPrefacePing(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		client, server := net.Pipe()
+		seen := wireServer(server, wireOptions{})
+		cc, err := (&Transport{}).newClientConn(client, false, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		time.Sleep(time.Minute)
+		req, _ := http.NewRequestWithContext(context.Background(), http.MethodGet, "https://example.com/", nil)
+		resp, err := cc.RoundTrip(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+		client.Close()
+		for f := range seen {
+			if f.typ == FramePing {
+				t.Error("PING sent")
+			}
+		}
+	})
+}
