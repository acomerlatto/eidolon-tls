diff --git a/internal/http2/eidolon_altsvc.go b/internal/http2/eidolon_altsvc.go
new file mode 100644
index 0000000..b062b64
--- /dev/null
+++ b/internal/http2/eidolon_altsvc.go
@@ -0,0 +1,248 @@
+// The Alt-Svc value of an ALTSVC frame as quiche checks it (patch 0037).
+
+package http2
+
+import "bytes"
+
+// altSvcValid reports whether quiche's
+// SpdyAltSvcWireFormat::ParseHeaderFieldValue accepts v, the field value of
+// an ALTSVC frame; Http2DecoderAdapter::OnAltSvcEnd reports
+// SPDY_INVALID_CONTROL_FRAME otherwise. It follows the parser step by step,
+// quirks included, and keeps nothing it parses; the checks of the parser
+// that a later one covers are left out.
+func altSvcValid(v []byte) bool {
+	if len(v) == 0 {
+		return false
+	}
+	if string(v) == "clear" {
+		return true
+	}
+	end := len(v)
+	c := 0
+	for c != end {
+		// protocol-id, percent-encoded
+		eq := indexFrom(v, c, '=')
+		protocolID, ok := altSvcPercentDecode(v[c:eq])
+		if eq == c || !ok {
+			return false
+		}
+		ietfQUIC := protocolID == "hq"
+		c = eq
+		if c == end {
+			return false
+		}
+		c++
+		// alt-authority, quoted, with backslash escapes
+		if c == end || v[c] != '"' {
+			return false
+		}
+		c++
+		authority := c
+		for ; c != end && v[c] != '"'; c++ {
+			if v[c] != '\\' {
+				continue
+			}
+			c++
+			if c == end {
+				return false
+			}
+		}
+		if c == end || !altSvcAuthorityValid(v[authority:c]) {
+			return false
+		}
+		c++
+		// parameters, up to the next comma
+		paramsEnd := indexFrom(v, c, ',')
+		for c != paramsEnd {
+			c = skipWhiteSpace(v, c, paramsEnd)
+			if c == paramsEnd {
+				break
+			}
+			if v[c] != ';' {
+				return false
+			}
+			c++
+			c = skipWhiteSpace(v, c, paramsEnd)
+			if c == paramsEnd {
+				break
+			}
+			var name []byte
+			for ; c != paramsEnd && v[c] != '=' && v[c] != ' ' && v[c] != '\t'; c++ {
+				name = append(name, asciiLower(v[c]))
+			}
+			c = skipWhiteSpace(v, c, paramsEnd)
+			if c == paramsEnd || v[c] != '=' {
+				return false
+			}
+			c++
+			c = skipWhiteSpace(v, c, paramsEnd)
+			value := c
+			for ; c != paramsEnd && v[c] != ';' && v[c] != ' ' && v[c] != '\t'; c++ {
+			}
+			if c == value {
+				return false
+			}
+			switch {
+			case string(name) == "ma":
+				if !altSvcPositive(v[value:c], 1<<32-1) {
+					return false
+				}
+			case !ietfQUIC && string(name) == "v":
+				// A quoted list of versions, which may hold commas: the
+				// end of the parameters moves past it.
+				if v[value] != '"' {
+					return false
+				}
+				c = indexFrom(v, value+1, '"')
+				if c == end {
+					return false
+				}
+				c++
+				paramsEnd = indexFrom(v, c, ',')
+				for vb := value + 1; vb < c; {
+					ve := vb
+					for ve < c-1 && v[ve] != ',' {
+						ve++
+					}
+					if !altSvcPositive(v[vb:ve], 1<<16-1) {
+						return false
+					}
+					vb = ve + 1
+				}
+			case ietfQUIC && string(name) == "quic":
+				// A QUIC version tag in hex, without leading zeros,
+				// which also leaves out 0.
+				if v[value] == '0' || !altSvcHex32(v[value:c]) {
+					return false
+				}
+			}
+		}
+		for ; c != end && (v[c] == ' ' || v[c] == '\t' || v[c] == ','); c++ {
+		}
+	}
+	return true
+}
+
+// indexFrom returns the index of the first b in v from i, or len(v).
+func indexFrom(v []byte, i int, b byte) int {
+	if j := bytes.IndexByte(v[i:], b); j >= 0 {
+		return i + j
+	}
+	return len(v)
+}
+
+// skipWhiteSpace returns the index of the first byte from c to end that is
+// neither a space nor a tab, or end.
+func skipWhiteSpace(v []byte, c, end int) int {
+	for c != end && (v[c] == ' ' || v[c] == '\t') {
+		c++
+	}
+	return c
+}
+
+func asciiLower(b byte) byte {
+	if 'A' <= b && b <= 'Z' {
+		return b + 'a' - 'A'
+	}
+	return b
+}
+
+func hexDigit(b byte) (byte, bool) {
+	switch {
+	case '0' <= b && b <= '9':
+		return b - '0', true
+	case 'a' <= b && b <= 'f':
+		return b - 'a' + 10, true
+	case 'A' <= b && b <= 'F':
+		return b - 'A' + 10, true
+	}
+	return 0, false
+}
+
+// altSvcPercentDecode decodes the %XX escapes of s, as PercentDecode.
+func altSvcPercentDecode(s []byte) (string, bool) {
+	var out []byte
+	for i := 0; i < len(s); i++ {
+		if s[i] != '%' {
+			out = append(out, s[i])
+			continue
+		}
+		if i+2 >= len(s) {
+			return "", false
+		}
+		hi, ok1 := hexDigit(s[i+1])
+		lo, ok2 := hexDigit(s[i+2])
+		if !ok1 || !ok2 {
+			return "", false
+		}
+		out = append(out, hi<<4|lo)
+		i += 2
+	}
+	return string(out), true
+}
+
+// altSvcAuthorityValid reports whether ParseAltAuthority accepts a: an
+// optional host, a bracketed IPv6 literal or a name with backslash
+// escapes, then a colon and a port from 1 to 65535.
+func altSvcAuthorityValid(a []byte) bool {
+	if len(a) == 0 {
+		return false
+	}
+	c, end := 0, len(a)
+	if a[c] == '[' {
+		for ; c != end && a[c] != ']'; c++ {
+			if a[c] == '"' {
+				return false
+			}
+		}
+		if c == end {
+			return false
+		}
+		c++
+	} else {
+		for ; c != end && a[c] != ':'; c++ {
+			if a[c] == '"' {
+				return false
+			}
+			if a[c] == '\\' {
+				c++
+				if c == end {
+					return false
+				}
+			}
+		}
+	}
+	if c == end || a[c] != ':' {
+		return false
+	}
+	return altSvcPositive(a[c+1:], 1<<16-1)
+}
+
+// altSvcPositive reports whether s is a decimal integer from 1 to max, as
+// ParsePositiveIntegerImpl.
+func altSvcPositive(s []byte, max uint64) bool {
+	var n uint64
+	for _, b := range s {
+		if b < '0' || b > '9' {
+			return false
+		}
+		if n = n*10 + uint64(b-'0'); n > max {
+			return false
+		}
+	}
+	return n > 0
+}
+
+// altSvcHex32 reports whether s, not empty, is up to 8 hex digits, as
+// HexDecodeToUInt32 accepts.
+func altSvcHex32(s []byte) bool {
+	if len(s) > 8 {
+		return false
+	}
+	for _, b := range s {
+		if _, ok := hexDigit(b); !ok {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/http2/eidolon_altsvc_test.go b/internal/http2/eidolon_altsvc_test.go
new file mode 100644
index 0000000..6fea87e
--- /dev/null
+++ b/internal/http2/eidolon_altsvc_test.go
@@ -0,0 +1,58 @@
+package http2
+
+import "testing"
+
+// altSvcValid accepts and refuses what quiche's ParseHeaderFieldValue
+// does, with the values of its tests (spdy_alt_svc_wire_format_test.cc).
+func TestAltSvcValid(t *testing.T) {
+	for _, v := range []string{
+		"clear",
+		`h3=":443"; ma=86400, h3-29=":443"; ma=86400`,
+		`h2="example.com:443"`,
+		`quic=":443"; ma=2592000; v="46,43"`,
+		`quic="[2003:8:0:16::509d:9615]:443"; v="36,35"; ma=60`,
+		`hq=":443";quic=51303338;quic=51303334`,
+		`hq=":443"; v=24`, // v is not a parameter of hq
+		`a%25=":1"`,
+		`a="b\"c:1"`,
+		`a="b:042"; MA=7 ;  unknown=x  ,, b=":2"`,
+		`a="b:42" ; `,
+		`a="b:65535"; ma=4294967295`,
+		`hq=":1";quic=51303A38`,
+		`A%2f%2F=":1"`,
+	} {
+		if !altSvcValid([]byte(v)) {
+			t.Errorf("%q refused", v)
+		}
+	}
+	for _, v := range []string{
+		"",
+		"a%", "a%x", "a%b", "a%9z", "a=", `a="`, `a="b"`, `a=":"`, `a="c:"`,
+		`a="c:foo"`, `a="c:42foo"`, `a="b:42"bar`, `a="b:42" ; m`,
+		`a="b:42" ; min-age`, `a="b:42" ; ma`, `a="b:42" ; ma=`,
+		`a="b:42" ; v=".."`, `a="b:42" ; ma=ma`, `a="b:42" ; ma=123bar`,
+		`a="b:42" ; v=24`, `a="b:42" ; v=24,25`, `a="b:42" ; v="-3"`,
+		`a="b:42" ; v="1.2"`, `a="b:42" ; v="24,"`,
+		// Others: an empty protocol, port 0 or above 65535, ma above
+		// 2^32-1, a bracket not closed, a quote in brackets, a quic tag
+		// with a leading zero, of value 0 or over 8 digits, an escape at
+		// the end, an unclosed version list.
+		`=":1"`, `a=":0"`, `a=":65536"`, `a=":1"; ma=4294967296`, `a="[::1:1"`,
+		`a="[\"]:1"`, `hq=":1";quic=051`, `hq=":1";quic=0`, `hq=":1";quic=123456789`,
+		`hq=":1";quic=5x`, `a="b\`, `a=":1"; v="1`, `a=":1"; v=""`, "a=\":1\"\x00",
+		`a=""`, `a=x:1"`, `a=":1"; x y=1`, `a=":1"; x=`, `a=":1"; v=x5"`, `a=":1"; v="65536"`,
+		`a=":1"; MA=x`, `a="[::1]x1"`, "a=\":1\",\t=\":2\"", `a%x=":1"`, `a%2x=":1"`, `a%x2=":1"`,
+	} {
+		if altSvcValid([]byte(v)) {
+			t.Errorf("%q accepted", v)
+		}
+	}
+	// A value cut before its closing quote is refused at every length.
+	for _, v := range []string{`a=":137"`, `a="foo:137"`, `a%25="foo\"bar\\baz:137"`} {
+		for n := 1; n < len(v); n++ {
+			if altSvcValid([]byte(v[:n])) {
+				t.Errorf("%q accepted", v[:n])
+			}
+		}
+	}
+}
