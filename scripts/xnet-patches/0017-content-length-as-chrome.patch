+// digits reports whether s has digits only, as the Content-Length syntax
+// (RFC 9110 section 8.6, 1*DIGIT); ParseInt also takes a sign, and refuses
+// an empty s.
+func digits(s string) bool {
+	return strings.Trim(s, "0123456789") == ""
+}
